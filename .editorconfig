root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,ts,html,scss,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Organização de usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# C# moderno
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion

# Qualidade
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_code_quality_unused_parameters = all:suggestion

# Nomenclatura: interfaces com I
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

# Nomenclatura: private static readonly em PascalCase (são constantes na prática)
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly_field
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_style
dotnet_naming_symbols.private_static_readonly_field.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_field.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_field.required_modifiers = static,readonly
dotnet_naming_style.pascal_style.capitalization = pascal_case

# Nomenclatura: const privado em PascalCase
dotnet_naming_rule.private_const_pascal.severity = warning
dotnet_naming_rule.private_const_pascal.symbols = private_const_field
dotnet_naming_rule.private_const_pascal.style = pascal_style
dotnet_naming_symbols.private_const_field.applicable_kinds = field
dotnet_naming_symbols.private_const_field.applicable_accessibilities = private
dotnet_naming_symbols.private_const_field.required_modifiers = const

# Nomenclatura: campos privados com _
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

# Projetos de teste: nomes no padrão Metodo_Cenario_ResultadoEsperado
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none